  "pubmed": {
    "retmax_per_query": 10,
    "query_templates": [
      "{gene}[tiab] AND (\"loss of function\"[tiab] OR \"gain of function\"[tiab]) AND hasabstract AND english[lang]",
      "{gene}[tiab] AND (phenotype[tiab] OR \"natural history\"[tiab] OR cohort[tiab]) AND hasabstract AND english[lang]",
      "{gene}[tiab] AND (\"sodium channel blocker\"[tiab] OR \"sodium channel blockers\"[tiab] OR treatment[tiab]) AND hasabstract AND english[lang]"
    ],
    "extra_queries": [
      "\"Dravet syndrome\"[tiab] AND \"natural history\"[tiab] AND hasabstract AND english[lang]"
    ],
    "extra_pmids": [],
    "efetch_batch_size": 100
  },
  "clinvar": {
    "variation_ids": []
  },
  "medrxiv": {
    "dois": [],
    "scrape_json_path": "medrxiv.json",
    "filter_pattern": "SCN1A|SCN2A|KCNQ2|STXBP1|Dravet|SCN8A|SNAP25|STX1B",
    "api_urls": [
      "https://api.medrxiv.org/details/medrxiv/{doi}/na/json",
      "https://api.biorxiv.org/details/medrxiv/{doi}/na/json"
    ]
  },
  "ctgov": {
    "page_size": 100,
    "max_pages_per_query": 5,
    "queries": [
      {
        "cond": "Dravet syndrome"
      },
      {
        "term": "SCN1A"
      },
      {
        "term": "SCN2A"
      },
      {
        "term": "KCNQ2"
      },
      {
        "term": "STXBP1"
      }
    ]
  },
  "reporter": {
    "limit": 100,
    "terms": [
      "SCN1A",
      "SCN2A",
      "KCNQ2",
      "STXBP1"
    ],
    "search_field": "projecttitle,abstracttext"
  },
  "orcid": {
    "ids": []
  },
